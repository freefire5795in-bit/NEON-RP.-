# Never put this file with real values in a public repository. Copy to .env on the server.
DISCORD_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
DISCORD_APPLICATION_CHANNEL_ID=PUT_APPLICATION_CHANNEL_ID_HERE
PORT=3000
# Exact deployed website origin, e.g. https://neon.example.com (no trailing slash).
ALLOWED_ORIGIN=https://YOUR-WEBSITE-DOMAIN.example
# Generate a long random secret. Website does not receive this value.
APPLICATION_SHARED_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
# Required for real approve/reject button permissions. Use the Discord staff role ID.
STAFF_ROLE_ID=PUT_STAFF_ROLE_ID_HERE
